<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.PlayerActivity">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:auto_show="true"
        app:hide_on_touch="false"
        app:controller_layout_id="@layout/custom_player_control"
        app:keep_content_on_player_reset="true"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:show_timeout="5000"
        app:surface_type="surface_view"
        app:use_controller="true" />

    <SurfaceView
        android:id="@+id/airplay_mirror_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:keepScreenOn="true"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:background="#000000"
        android:contentDescription="@string/player_image_description"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_player_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="48dp"
        android:paddingTop="28dp"
        android:paddingRight="48dp"
        android:paddingBottom="46dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/player_remote_hint" android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:id="@+id/tv_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="24dp" android:text="@string/connected" android:textColor="@color/success" android:textSize="17sp" android:textStyle="bold" />
        <ProgressBar android:id="@+id/buffering_indicator" style="?android:attr/progressBarStyleSmall" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginLeft="12dp" android:indeterminateTint="@color/accent" android:visibility="gone" />
    </LinearLayout>

    <TextView android:id="@+id/tv_stream_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="108dp" android:layout_marginEnd="48dp" android:background="@drawable/bg_stream_info" android:elevation="8dp" android:fontFamily="monospace" android:lineSpacingExtra="5dp" android:padding="20dp" android:textColor="@color/text_primary" android:textSize="16sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/loading_panel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical">
        <ProgressBar android:id="@+id/progress_bar" android:layout_width="56dp" android:layout_height="56dp" android:indeterminate="true" android:indeterminateTint="@color/accent" android:visibility="visible" />
    </LinearLayout>

    <TextView android:id="@+id/tv_error" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="64dp" android:background="@drawable/bg_tv_panel" android:gravity="center" android:maxWidth="760dp" android:paddingLeft="32dp" android:paddingTop="24dp" android:paddingRight="32dp" android:paddingBottom="24dp" android:textColor="@color/error" android:textSize="22sp" android:textStyle="bold" android:visibility="gone" />
</FrameLayout>

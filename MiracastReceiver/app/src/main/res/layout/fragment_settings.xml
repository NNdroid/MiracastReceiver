<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="34dp"
        android:paddingTop="28dp"
        android:paddingRight="42dp"
        android:paddingBottom="34dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_settings" android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/settings_subtitle" android:textColor="@color/text_secondary" android:textSize="14sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_tv_panel" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/system_capabilities" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_root_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/root_status_checking" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <TextView android:id="@+id/tv_shizuku_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="@string/shizuku_status_checking" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <TextView android:id="@+id/tv_overlay_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="@string/overlay_status_checking" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <TextView android:id="@+id/tv_boot_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="@string/boot_status_checking" android:textColor="@color/text_secondary" android:textSize="14sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_auto_start" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="12dp" android:background="@drawable/bg_setting_item" android:focusable="true" android:nextFocusLeft="@id/nav_settings" android:paddingLeft="18dp" android:paddingRight="18dp" android:text="@string/auto_start_on_boot" android:textColor="@color/text_primary" android:textSize="17sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_tv_panel" android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:layout_marginBottom="8dp" android:text="@string/receiver_protocols" android:textColor="@color/text_secondary" android:textSize="14sp" android:textStyle="bold" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_airplay" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_setting_item" android:focusable="true" android:nextFocusLeft="@id/nav_settings" android:paddingLeft="16dp" android:paddingRight="16dp" android:text="AirPlay" android:textColor="@color/text_primary" android:textSize="16sp" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_dlna" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:background="@drawable/bg_setting_item" android:focusable="true" android:nextFocusLeft="@id/nav_settings" android:paddingLeft="16dp" android:paddingRight="16dp" android:text="DLNA / UPnP" android:textColor="@color/text_primary" android:textSize="16sp" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_miracast" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:background="@drawable/bg_setting_item" android:focusable="true" android:nextFocusLeft="@id/nav_settings" android:paddingLeft="16dp" android:paddingRight="16dp" android:text="Miracast / WFD" android:textColor="@color/text_primary" android:textSize="16sp" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_webui" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:background="@drawable/bg_setting_item" android:focusable="true" android:nextFocusLeft="@id/nav_settings" android:paddingLeft="16dp" android:paddingRight="16dp" android:text="@string/webui_lan_management" android:textColor="@color/text_primary" android:textSize="16sp" />
        </LinearLayout>

        <Button android:id="@+id/btn_optimize_background" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="12dp" android:background="@drawable/bg_tv_action" android:focusable="true" android:nextFocusLeft="@id/nav_settings" android:text="@string/optimize_background" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
        <Button android:id="@+id/btn_restart_receiver" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="10dp" android:background="@drawable/bg_tv_action" android:focusable="true" android:nextFocusLeft="@id/nav_settings" android:text="@string/restart_receiver" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>

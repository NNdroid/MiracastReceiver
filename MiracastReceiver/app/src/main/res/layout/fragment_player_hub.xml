<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="34dp"
    android:paddingTop="28dp"
    android:paddingRight="42dp"
    android:paddingBottom="34dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_player" android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/player_hub_subtitle" android:textColor="@color/text_secondary" android:textSize="14sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/bg_tv_hero" android:orientation="vertical" android:padding="26dp">
        <TextView android:id="@+id/tv_player_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_player_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_player_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/text_secondary" android:textSize="15sp" />
        <TextView android:id="@+id/tv_player_uri" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:ellipsize="middle" android:maxLines="2" android:textColor="@color/text_muted" android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_tv_panel" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_hub_remote_title" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/player_hub_remote_body" android:textColor="@color/text_secondary" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>

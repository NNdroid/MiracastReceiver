<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_player_control_scrim"
    android:orientation="vertical"
    android:paddingLeft="48dp"
    android:paddingTop="38dp"
    android:paddingRight="48dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_player_controls_panel"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="18dp"
        android:paddingRight="24dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exo_position"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/player_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusDown="@id/exo_play_pause"
                app:played_color="@color/accent"
                app:buffered_color="@color/player_buffered"
                app:unplayed_color="@color/player_unplayed"
                app:scrubber_color="@color/accent"
                app:scrubber_dragged_size="20dp"
                app:scrubber_enabled_size="15dp"
                app:scrubber_disabled_size="0dp" />

            <TextView
                android:id="@+id/exo_duration"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/player_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/exo_prev"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/bg_player_button_tv"
                android:contentDescription="@string/player_previous"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/btn_more"
                android:nextFocusRight="@id/exo_rew"
                android:nextFocusUp="@id/exo_progress"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/player_text_primary" />

            <ImageButton
                android:id="@+id/exo_rew"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/bg_player_button_tv"
                android:contentDescription="@string/player_rewind"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/exo_prev"
                android:nextFocusRight="@id/exo_play_pause"
                android:nextFocusUp="@id/exo_progress"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_rew"
                android:tint="@color/player_text_primary" />

            <ImageButton
                android:id="@+id/exo_play_pause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_player_button_tv"
                android:contentDescription="@string/player_play_pause"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/exo_rew"
                android:nextFocusRight="@id/exo_ffwd"
                android:nextFocusUp="@id/exo_progress"
                android:padding="17dp"
                android:scaleType="fitCenter"
                android:tint="@color/player_text_primary" />

            <ImageButton
                android:id="@+id/exo_ffwd"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/bg_player_button_tv"
                android:contentDescription="@string/player_fast_forward"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/exo_play_pause"
                android:nextFocusRight="@id/exo_next"
                android:nextFocusUp="@id/exo_progress"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_ff"
                android:tint="@color/player_text_primary" />

            <ImageButton
                android:id="@+id/exo_next"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/bg_player_button_tv"
                android:contentDescription="@string/player_next"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/exo_ffwd"
                android:nextFocusRight="@id/btn_more"
                android:nextFocusUp="@id/exo_progress"
                android:padding="15dp"
                android:rotation="180"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/player_text_primary" />

            <ImageButton
                android:id="@+id/btn_more"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/bg_player_button_tv"
                android:contentDescription="@string/player_more"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/exo_next"
                android:nextFocusRight="@id/exo_prev"
                android:nextFocusUp="@id/exo_progress"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_more"
                android:tint="@color/player_text_primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

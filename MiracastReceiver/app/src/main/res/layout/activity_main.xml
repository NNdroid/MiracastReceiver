<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingTop="36dp"
        android:paddingRight="48dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tv_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="14dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_tv_panel"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/receiver_status"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textColor="@color/success"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="@string/waiting_connection"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_device_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="客厅 Android TV" />

                <TextView
                    android:id="@+id/tv_device_ip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="17sp"
                    tools:text="设备 IP: 192.168.1.100" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/connection_code_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_connection_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.18"
                    android:textColor="@color/accent"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="ABC123" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="WebUI 管理"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_webui_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="true"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="http://192.168.1.100:8090" />

                <TextView
                    android:id="@+id/tv_webui_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/accent"
                    android:textIsSelectable="true"
                    android:textSize="14sp"
                    tools:text="Token: 0123456789abcdef" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tv_panel"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/privileged_status"
                        android:textColor="@color/text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView android:id="@+id/tv_root_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/root_status_checking" android:textColor="@color/text_secondary" android:textSize="16sp" />
                    <TextView android:id="@+id/tv_shizuku_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/shizuku_status_checking" android:textColor="@color/text_secondary" android:textSize="16sp" />
                    <TextView android:id="@+id/tv_overlay_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/overlay_status_checking" android:textColor="@color/text_secondary" android:textSize="16sp" />
                    <TextView android:id="@+id/tv_boot_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/boot_status_checking" android:textColor="@color/text_secondary" android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/bg_setting_item"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_auto_start"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:minHeight="54dp"
                        android:nextFocusDown="@id/switch_airplay"
                        android:text="@string/auto_start_on_boot"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/auto_start_on_boot_hint"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_tv_panel"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="接收协议快捷开关"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_airplay" android:layout_width="match_parent" android:layout_height="52dp" android:focusable="true" android:nextFocusUp="@id/switch_auto_start" android:nextFocusDown="@id/switch_dlna" android:text="AirPlay" android:textColor="@color/text_primary" android:textSize="17sp" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_dlna" android:layout_width="match_parent" android:layout_height="52dp" android:focusable="true" android:nextFocusUp="@id/switch_airplay" android:nextFocusDown="@id/switch_miracast" android:text="DLNA / UPnP" android:textColor="@color/text_primary" android:textSize="17sp" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_miracast" android:layout_width="match_parent" android:layout_height="52dp" android:focusable="true" android:nextFocusUp="@id/switch_dlna" android:nextFocusDown="@id/switch_webui" android:text="Miracast / WFD" android:textColor="@color/text_primary" android:textSize="17sp" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_webui" android:layout_width="match_parent" android:layout_height="52dp" android:focusable="true" android:nextFocusUp="@id/switch_miracast" android:nextFocusDown="@id/btn_optimize_background" android:text="WebUI" android:textColor="@color/text_primary" android:textSize="17sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_optimize_background"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_tv_action"
                    android:focusable="true"
                    android:nextFocusDown="@id/btn_restart_receiver"
                    android:nextFocusUp="@id/switch_webui"
                    android:text="@string/optimize_background"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_restart_receiver"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_tv_action"
                    android:focusable="true"
                    android:nextFocusUp="@id/btn_optimize_background"
                    android:text="@string/restart_receiver"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_tv_panel"
            android:orientation="horizontal"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/how_to_connect" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" android:text="@string/connect_instruction" android:textColor="@color/text_secondary" android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginLeft="28dp"
                android:text="@string/remote_hint"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
